{
  "name": "cloudflare-vps-monitoring",
  "version": "1.0.0",
  "description": "Production-ready, zero-agent VPS Monitoring Dashboard built on Cloudflare Workers, D1, Cron Triggers, React, and Tailwind CSS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --outfile=dist-worker/index.js --platform=browser --target=es2022 --external:cloudflare:*",
    "build": "npm run build:client",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:init": "wrangler d1 execute vps_monitor_db --local --file=./migrations/0001_initial_schema.sql",
    "d1:init:prod": "wrangler d1 execute vps_monitor_db --remote --file=./migrations/0001_initial_schema.sql"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.168.0"
  }
}
